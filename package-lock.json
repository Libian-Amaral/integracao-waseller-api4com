# =====================================================================
#  CONFIGURACAO DA INTEGRACAO WASELLER <-> API4COM
#  Copie este arquivo para ".env" e preencha os valores.
#  NUNCA compartilhe o arquivo .env preenchido: ele contem credenciais.
# =====================================================================

# ----- Servidor -----
# Porta do servico (no Render isso e definido automaticamente; pode deixar 3000).
PORT=3000

# Segredo que faz parte da URL dos webhooks. Invente uma palavra longa e
# aleatoria (ex: 30+ caracteres, letras e numeros). Isso impede que pessoas
# de fora disparem os webhooks.
WEBHOOK_SECRET=troque-este-segredo-por-algo-bem-aleatorio

# URL publica do servico. Preencha DEPOIS de fazer o deploy no Render.
# Ex: https://integracao-waseller-api4com.onrender.com
PUBLIC_URL=

# ----- Acesso ao painel de ligacoes (recomendado preencher) -----
# Usuario e senha para abrir o painel. Se deixar em branco, o painel fica
# aberto para qualquer pessoa que tiver o link.
PAINEL_USUARIO=adm
PAINEL_SENHA=troque-esta-senha

# ----- API4COM (voz) -----
# Token de acesso PERMANENTE da API4COM.
# Para gerar: rode  npm run gerar-token:api4com
API4COM_TOKEN=

# Ramal (extension) que vai realizar as ligacoes. Voce ve o numero do ramal
# no Webphone da API4COM (ex: 1000).
API4COM_EXTENSION=

# Nome do "gateway" que amarra as ligacoes ao webhook de retorno.
# Pode deixar o valor padrao abaixo.
API4COM_GATEWAY=waseller-api4com

# ----- WaSeller (Wascript) -----
# Token da API do WaSeller. No WaSeller: modulo "API" -> "Configurar API".
WASELLER_TOKEN=

# Registrar uma nota no lead quando a ligacao terminar? (true / false)
WASELLER_REGISTRAR_NOTA=true

# (Opcional) Etiquetas para marcar o resultado da ligacao no WaSeller.
# Deixe em branco para nao usar etiquetas. Para descobrir os IDs das
# etiquetas, rode:  node scripts/listar-etiquetas-waseller.js
WASELLER_LABEL_ATENDIDA=
WASELLER_LABEL_NAO_ATENDIDA=
